DATABASE_URL=postgres://htake:htake_dev@localhost:5432/htake
BETTER_AUTH_SECRET=change-me-32-chars-minimum
BETTER_AUTH_URL=http://localhost:3000
OPENAI_API_KEY=
# Chat model (cheapest that handles Burmese well; test gpt-5.4-nano vs gpt-5.4-mini)
OPENAI_MODEL_CHAT=gpt-6-luna
# USD per 1M tokens for the chosen model. REQUIRED for an accurate spending cap:
# if unset, a high fallback price is used so the cap trips early rather than late.
OPENAI_PRICE_IN_PER_M=
OPENAI_PRICE_OUT_PER_M=
# Content studio captions. Blank = use the chat model. Candidate to try later: gpt-6.1-sol
OPENAI_MODEL_CONTENT=
# Content studio pictures (an image model; gpt-6-luna cannot draw). Candidates: gpt-image-2.5-sunburst, gpt-image-2.5-flare
OPENAI_MODEL_IMAGE=gpt-image-2
# low | medium | high. Use low while testing: it is much cheaper.
OPENAI_IMAGE_QUALITY=medium
# USD per 1M tokens for the image model (OpenAI pricing page: 5 text/image input, 30 image output). If unset, 0.06 USD per image is assumed.
OPENAI_PRICE_IMAGE_IN_PER_M=5
OPENAI_PRICE_IMAGE_OUT_PER_M=30
OPENAI_MODEL_TRANSCRIBE=gpt-transcribe
# USD per minute of voice-message audio (OpenAI pricing page lists gpt-transcribe at 0.0045)
OPENAI_PRICE_TRANSCRIBE_PER_MIN=0.0045
# Hard monthly AI spending cap in USD (the app stops answering when reached)
AI_MONTHLY_CAP_USD=20
# Username(s) of the developer account (a CEO account). Only they see AI cost in dollars and can set the cap.
DEVELOPER_USERNAMES=
# Signs tool-approval requests; defaults to BETTER_AUTH_SECRET if unset
TOOL_APPROVAL_SECRET=
# Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# 32-byte hex key used to encrypt the Facebook token and other secrets
ENCRYPTION_KEY=
