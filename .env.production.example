# Copy to .env.production on the server and fill in. Never commit the real file.
# Hostname people will open. Free options: your Hostinger hostname (srvNNNN.hstgr.cloud, shown in hPanel)
# or <server-ip-with-dashes>.sslip.io (e.g. 203-0-113-10.sslip.io). Or your own domain pointed at the VPS.
DOMAIN=
POSTGRES_PASSWORD=
# openssl rand -hex 32
BETTER_AUTH_SECRET=
TOOL_APPROVAL_SECRET=
ENCRYPTION_KEY=
OPENAI_API_KEY=
OPENAI_MODEL_CHAT=gpt-6-luna
OPENAI_PRICE_IN_PER_M=0.10
OPENAI_PRICE_OUT_PER_M=0.50
OPENAI_MODEL_TRANSCRIBE=gpt-transcribe
# USD per minute of voice-message audio (OpenAI pricing page lists gpt-transcribe at 0.0045)
OPENAI_PRICE_TRANSCRIBE_PER_MIN=0.0045
AI_MONTHLY_CAP_USD=5
# Your username (a CEO account): only you see AI cost in dollars
DEVELOPER_USERNAMES=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# Only when using docker-compose.traefik.yml (server already has Traefik)
TRAEFIK_NETWORK=
TRAEFIK_CERTRESOLVER=
